# =============================================================================
# Lumen — environment variables
# Copy to `.env` and fill values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — OpenRouter free tier (no credit card required for free models)
# Create a key at https://openrouter.ai/keys
# -----------------------------------------------------------------------------
# This secret is read only by the backend.
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Free-tier model router. You can pin a specific free model e.g.:
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemma-3-27b-it:free
# Leave as openrouter/auto:free to let OpenRouter pick the best available.
LUMEN_CHAT_MODEL=openrouter/auto:free

# Embedding model (only used when LUMEN_USE_MOCK_EMBEDDINGS=false)
LUMEN_EMBEDDING_MODEL=text-embedding-3-small

# Keep true to skip embedding API calls — zero cost, structural retrieval only.
# Set false only if you add a paid OpenAI key for real semantic embeddings.
LUMEN_USE_MOCK_EMBEDDINGS=true

# -----------------------------------------------------------------------------
# Web search — Tavily free tier (1,000 searches/month)
# Create a key at https://app.tavily.com
# -----------------------------------------------------------------------------
TAVILY_API_KEY=

# Serper.dev free tier alternative (2,500 searches free)
# SERPER_API_KEY=

# -----------------------------------------------------------------------------
# Vector store — Chroma persisted locally
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_PREFIX=lumen_session

# -----------------------------------------------------------------------------
# Fetch layer
# -----------------------------------------------------------------------------
LUMEN_HTTP_USER_AGENT=LumenResearchBot/0.1 (+https://example.com/contact)
LUMEN_FETCH_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Cost guards
# -----------------------------------------------------------------------------
LUMEN_MAX_OUTPUT_TOKENS=4096
LUMEN_MAX_RETRIEVAL_CHUNKS=24

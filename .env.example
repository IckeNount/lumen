# =============================================================================
# Lumen — environment variables
# Copy to `.env` and fill values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM providers — set at least one for the core pipeline and notebooks.
# -----------------------------------------------------------------------------
# OpenAI: chat completions, embeddings (if used), tokenizers align with tiktoken.
OPENAI_API_KEY=

# Anthropic: alternative / second provider for synthesis or A/B (optional).
ANTHROPIC_API_KEY=

# Default provider for app + notebooks: openai | anthropic
LUMEN_LLM_PROVIDER=openai

# Default chat model id (must match provider capabilities).
LUMEN_CHAT_MODEL=gpt-4o-mini

# Default embedding model when we wire retrieval (OpenAI naming).
LUMEN_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Web search — real HTTP search (Tavily recommended; Serper optional).
# -----------------------------------------------------------------------------
TAVILY_API_KEY=

# Serper.dev Google Search API (alternative; leave blank if unused).
SERPER_API_KEY=

# -----------------------------------------------------------------------------
# Vector store — Chroma persisted locally until we opt into hosted.
# -----------------------------------------------------------------------------
# Absolute or relative path; created at runtime.
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Collection name prefix for session-scoped logical namespaces.
CHROMA_COLLECTION_PREFIX=lumen_session

# -----------------------------------------------------------------------------
# Fetch layer — polite HTTP defaults (required in production configs).
# -----------------------------------------------------------------------------
# Identifies your bot in logs; replace contact URL or email.
LUMEN_HTTP_USER_AGENT=LumenResearchBot/0.1 (+https://example.com/contact)

# Per-host concurrency cap for fetches (string for pydantic-settings).
LUMEN_FETCH_MAX_CONCURRENCY=4

# Request timeout for a single page fetch (seconds).
LUMEN_FETCH_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Observability — LangSmith (or compatible) for traces and eval runs.
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=lumen
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional: separate LangSmith workspace for prod vs dev.
# LANGCHAIN_WORKSPACE_ID=

# Structured application logging level: DEBUG | INFO | WARNING | ERROR
LUMEN_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Application / deployment — fill as we expose a public URL.
# -----------------------------------------------------------------------------
# Secret for signing session cookies or API tokens (generate a long random string).
LUMEN_SECRET_KEY=

# Public base URL of the deployed app (no trailing slash); used in callbacks and CORS.
LUMEN_PUBLIC_URL=

# Process bind (local dev).
LUMEN_HOST=127.0.0.1
LUMEN_PORT=8000

# Database URL if we add Postgres for sessions/users (optional weeks 3–4).
# DATABASE_URL=postgresql://user:pass@host:5432/lumen

# -----------------------------------------------------------------------------
# Rate limits & cost guards (tune in week 3).
# -----------------------------------------------------------------------------
# Max LLM output tokens per synthesis call (string for settings).
LUMEN_MAX_OUTPUT_TOKENS=4096

# Max total retrieved chunks per report (string).
LUMEN_MAX_RETRIEVAL_CHUNKS=24
